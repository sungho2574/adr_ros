<?xml version="1.0"?>
<package format="3">
  <name>adr_bringup</name><version>0.0.1</version>
  <description>Jetson bringup for autonomous drone racing.</description>
  <maintainer email="jake@arkelectron.com">Precision Landing Maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>adr_camera</exec_depend><exec_depend>adr_perception</exec_depend>
  <exec_depend>adr_viz</exec_depend><exec_depend>adr_logging</exec_depend>
  <exec_depend>adr_streaming</exec_depend>
  <exec_depend>adr_control</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
